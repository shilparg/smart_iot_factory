{
  "id": null,
  "title": "IoT Simulator Metrics",
  "tags": ["iot", "simulator", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Machine Temperature (°C)",
      "targets": [
        {
          "expr": "machine_temperature",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Machine Vibration (m/s²)",
      "targets": [
        {
          "expr": "machine_vibration",
          "legendFormat": "{{device}}",
          "refId": "B"
        }
      ],
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Machine RPM",
      "targets": [
        {
          "expr": "machine_rpm",
          "legendFormat": "{{device}}",
          "refId": "C"
        }
      ],
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 }
    },
    {
      "type": "barchart",
      "title": "Anomaly Type Frequency (last 5m)",
      "targets": [
        {
          "expr": "count_over_time(anomaly_type[5m])",
          "legendFormat": "{{anomaly_type}}",
          "refId": "D"
        }
      ],
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 6 }
    }
  ]
}
