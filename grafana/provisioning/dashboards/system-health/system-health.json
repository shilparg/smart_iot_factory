{
  "id": null,
  "uid": "system-health",
  "title": "System Health Overview",
  "tags": ["system", "health"],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 2,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU Usage (%)",
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "100 - (avg by(instance)(irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU Usage",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent" }
      },
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Memory Usage (MB)",
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / 1024 / 1024",
          "legendFormat": "Used Memory",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "megabytes" }
      },
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Disk Usage (GB)",
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "(node_filesystem_size_bytes - node_filesystem_avail_bytes) / 1024 / 1024 / 1024",
          "legendFormat": "Used Disk",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "gigabytes" }
      },
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 }
    }
  ]
}
